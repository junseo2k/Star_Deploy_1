  events:
  - targetStock: {fileID: 11400000, guid: 82d619e385fbd7544b024707357f34bb, type: 2}
    eventText: "\uD30C\uC774\uD2B8\uD074\uB7FD\uC774 \uC5ED\uB300 \uCD5C\uB300 \uACA9\uD22C
      \uB300\uD68C\uB97C \uC608\uACE0! \"\uD504\uB860\uD2F0\uC5B4 \uCD5C\uAC15\uC744
      \uAC00\uB9B0\uB2E4!\" \uAE30\uB300\uAC10\uC774 \uD558\uB298\uC744 \uCC0C\uB985\uB2C8\uB2E4!"
    isPositive: 1
    changeMin: 8
    changeMax: 15
  - targetStock: {fileID: 11400000, guid: 82d619e385fbd7544b024707357f34bb, type: 2}
    eventText: "\uD30C\uC774\uD2B8\uD074\uB7FD\uC5D0\uC11C \uC2B9\uBD80 \uC870\uC791
      \uBC1C\uAC01! \"\uACBD\uAE30\uAC00 \uC9DC\uC5EC\uC9C4 \uAC01\uBCF8\uC774\uC5C8\uB2E4\"\uB294
      \uD3ED\uB85C\uC5D0 \uD32C\uB4E4\uC774 \uBD84\uB178! \uC218\uC0AC \uC2DC\uC791!"
    isPositive: 0
    changeMin: -20
    changeMax: -12
  - targetStock: {fileID: 11400000, guid: 04e415fad2efe69428a37230512575fe, type: 2}
    eventText: "\"\uC694\uC998 \uC774\uBD80\uCF54\uD0C0 \uACF5\uC5F0\uC774 \uC7AC\uBBF8\uC5C6\uB2E4\"\uB294
      \uD3C9\uAC00\uAC00 \uC3DF\uC544\uC9C0\uACE0 \uC788\uC2B5\uB2C8\uB2E4. \uAD00\uAC1D\uC774
      \uC904\uACE0 \uACA9\uD22C\uC7A5\uC73C\uB85C \uAC00\uB294 \uC0AC\uB78C\uC774
      \uB298\uC5C8\uB300\uC694."
    isPositive: 0
    changeMin: -10
    changeMax: -5
  - targetStock: {fileID: 11400000, guid: 84a07f2de43dc5247bbff7c9f67a8692, type: 2}
    eventText: "\uBCF8\uD30C\uC774\uC5B4 \uC8FC\uB958\uB97C \uB9C8\uC2DC\uACE0 \uAC74\uAC15
      \uBB38\uC81C\uB97C \uD638\uC18C\uD558\uB294 \uC0AC\uB840\uAC00 \uBCF4\uACE0\uB418\uC5C8\uC2B5\uB2C8\uB2E4.
      \uB3C4\uC218\uAC00 \uB108\uBB34 \uB192\uB2E4\uB294 \uBE44\uD310\uC785\uB2C8\uB2E4."
    isPositive: 0
    changeMin: -10
    changeMax: -5
  - targetStock: {fileID: 11400000, guid: 84a07f2de43dc5247bbff7c9f67a8692, type: 2}
    eventText: "\uBCF8\uD30C\uC774\uC5B4 \uC8FC\uB958\uAC00 \uC624\uD06C \uC804\uD1B5
