    changeMin: -10
    changeMax: -5
  - targetStock: {fileID: 11400000, guid: 02742c54f0d0adf468f1072f580b1105, type: 2}
    eventText: "\uC544\uC774\uC5B8\uCF54\uC5B4 \uCCA0\uAC15\uC774 \uC2E0\uC18C\uC7AC
