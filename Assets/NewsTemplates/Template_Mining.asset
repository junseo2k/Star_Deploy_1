    isPositive: 0
    changeMin: -10
    changeMax: -5
  - targetStock: {fileID: 11400000, guid: 1d3d396240826b84788238deff3e4423, type: 2}
    eventText: "\uAE00\uB7A8\uBA38\uB77D \uAD11\uC0B0\uC5D0\uC11C \uB0A9\uD488\uD55C
      \uAD11\uBB3C\uC758 \uD488\uC9C8 \uC870\uC791\uC774 \uC801\uBC1C\uB418\uC5C8\uC2B5\uB2C8\uB2E4.
      \uC2E0\uB8B0\uC5D0 \uD070 \uD0C0\uACA9\uC785\uB2C8\uB2E4."
    isPositive: 0
    changeMin: -20
    changeMax: -12
  - targetStock: {fileID: 11400000, guid: 93dc4ecd1dcc2754d9be528e1a9f137b, type: 2}
    eventText: "\uBE0C\uB8E8\uD2B8\uC2A4\uD2F8 \uACF5\uC7A5\uC5D0\uC11C \uC6A9\uAD11\uB85C\uAC00
      \uD3ED\uBC1C\uD588\uC2B5\uB2C8\uB2E4. \uC0DD\uC0B0 \uB77C\uC778\uC774 \uC644\uC804\uD788
      \uBA48\uCDC4\uC2B5\uB2C8\uB2E4."
    isPositive: 0
    changeMin: -15
    changeMax: -8
  - targetStock: {fileID: 11400000, guid: 93dc4ecd1dcc2754d9be528e1a9f137b, type: 2}
    eventText: "\uBE0C\uB8E8\uD2B8\uC2A4\uD2F8\uC774 \uC0C8 \uB2E8\uC870\uBC95\uC744
      \uAC1C\uBC1C\uD588\uC2B5\uB2C8\uB2E4. \"\uC624\uD06C \uCCA0\uAC15\uB3C4 \uC774
      \uC815\uB3C4\uBA74 \uC4F8 \uB9CC\uD558\uB2E4\"\uB294 \uD3C9\uAC00\uAC00 \uB098\uC624\uAE30
      \uC2DC\uC791\uD588\uC2B5\uB2C8\uB2E4."
    isPositive: 1
    changeMin: 5
    changeMax: 10
  - targetStock: {fileID: 11400000, guid: 8249dd1bf690694429095fe3a6b93f35, type: 2}
    eventText: "\uBE14\uB808\uC774\uC988\uB9C8\uC778 \uAE4A\uC740 \uACF3\uC5D0\uC11C
      \uC804\uC124\uB85C\uB9CC \uC804\uD574\uC9C0\uB358 \uD76C\uADC0 \uB9C8\uB098\uC11D
      \uAD11\uB9E5\uC774 \uBC1C\uACAC\uB418\uC5C8\uC2B5\uB2C8\uB2E4. \uB4DC\uC6CC\uD504
      \uC655\uAD6D\uC774 \uB5A0\uB4E4\uC369\uD569\uB2C8\uB2E4."
    isPositive: 1
    changeMin: 12
    changeMax: 20
  - targetStock: {fileID: 11400000, guid: 8249dd1bf690694429095fe3a6b93f35, type: 2}
    eventText: "\uBE14\uB808\uC774\uC988\uB9C8\uC778 \uAD11\uC0B0\uC5D0\uC11C \uB300\uADDC\uBAA8
