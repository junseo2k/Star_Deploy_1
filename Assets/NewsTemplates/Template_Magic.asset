  events:
  - targetStock: {fileID: 11400000, guid: 0a28bec1287f93d4badb54fdf7e9d887, type: 2}
    eventText: "\uB9C8\uB098\uCF54\uC5B4 \uC2E0\uC81C\uD488\uC5D0\uC11C \uB9C8\uBC95\uC774
      \uD3ED\uC8FC\uD558\uB294 \uC0AC\uACE0\uAC00 \uC787\uB530\uB974\uACE0 \uC788\uC2B5\uB2C8\uB2E4.
      \"\uC9D1\uC774 \uD0C4\uB2E4\"\uBA70 \uC18C\uBE44\uC790\uB4E4\uC774 \uB09C\uB9AC\uC785\uB2C8\uB2E4."
    changeMin: -15
    changeMax: -8
    isUncertain: 1
  - targetStock: {fileID: 11400000, guid: 0a28bec1287f93d4badb54fdf7e9d887, type: 2}
    eventText: "\uB9C8\uB098\uCF54\uC5B4\uC758 \uB9C8\uBC95 \uC0DD\uD65C\uC6A9\uD488\uC774
      \uB300\uB959 \uC804\uC5ED\uC5D0\uC11C \uB300\uD788\uD2B8\uB97C \uCE58\uACE0
      \uC788\uC2B5\uB2C8\uB2E4. \uC9D1\uC9D1\uB9C8\uB2E4 \uD558\uB098\uC529 \uC788\uC744
      \uC815\uB3C4\uB78D\uB2C8\uB2E4."
    changeMin: 8
    changeMax: 15
    isUncertain: 1
  - targetStock: {fileID: 11400000, guid: 0bf530229106ef7468ba523c52540e1c, type: 2}
    eventText: "\uB9C8\uB098\uCF54\uC5B4\uAC00 \uC800\uAC00 \uC81C\uD488\uC744 \uB0B4\uB193\uC73C\uBA74\uC11C
      \uB9C8\uB098\uD3A0\uC758 \uBC25\uADF8\uB987\uC744 \uC9C1\uC811 \uB178\uB9AC\uACE0
      \uC788\uC2B5\uB2C8\uB2E4. \uC7A5\uC0AC\uAC00 \uB69D \uB5A8\uC5B4\uC84C\uC2B5\uB2C8\uB2E4."
    changeMin: -10
    changeMax: -5
    isUncertain: 0
  - targetStock: {fileID: 11400000, guid: 63756c12e4f677248adb08dc86f838f2, type: 2}
    eventText: "\uB9C8\uC9C0\uB178\uC758 \uD575\uC2EC \uC2E4\uD5D8\uC774 \uB300\uC2E4\uD328\uB85C
