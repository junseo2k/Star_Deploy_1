    changeMax: 15
    isUncertain: 1
  - targetStock: {fileID: 11400000, guid: 7c4f091715cb6c44cbc6480ee4a34b8a, type: 2}
    eventText: "\uADF8\uB9B0\uB8E8\uD2B8 \uAC74\uC124\uC758 \uD575\uC2EC \uAC74\uCD95\uAC00\uAC00
