  events:
  - targetStock: {fileID: 11400000, guid: 4a417815cca3dd540af22a1fa23ef336, type: 2}
    eventText: "\uC2A4\uD2F8\uBE4C\uB354\uAC00 \uB4DC\uB808\uACE0\uB2C8\uC544 \uC694\uC0C8
      \uAC74\uC124\uC744 \uB530\uB0C8\uC2B5\uB2C8\uB2E4. \uB4DC\uB798\uACE4\uC744
      \uC704\uD55C \uC131\uCC44\uB97C \uB4DC\uC6CC\uD504\uAC00 \uC9D3\uB294 \uAC81\uB2C8\uB2E4."
