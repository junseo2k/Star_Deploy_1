  - targetStock: {fileID: 11400000, guid: 20fb4d276cabdcf43b1b211a34a2f62a, type: 2}
    eventText: "\uC544\uC774\uC5B8\uB9AC\uD3FC\uC774 \uB9C8\uBC95 \uAC15\uD654 \uAC11\uC637
