  - targetStock: {fileID: 11400000, guid: 16aef88362311fe46b0b66d9c7178d41, type: 2}
    eventText: "\uBE0C\uB808\uC2A4\uB9C8\uD06C\uAC00 \uC791\uC804 \uC911 \uD070 \uD0C0\uACA9\uC744
