    changeMin: 8
    changeMax: 15
  - targetStock: {fileID: 11400000, guid: 33d11c22f8931244e9de0ccc8f20070d, type: 2}
    eventText: "\uB9C8\uB178\uC0AC \uC655\uAD6D\uC774 \uC544\uC774\uC5B8\uD558\uD2B8\uC640\uC758
