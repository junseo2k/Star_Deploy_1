  events:
  - targetStock: {fileID: 11400000, guid: a71bfdbf57481854ca5adeac2b28cdf9, type: 2}
    eventText: "\uB4DC\uB798\uACE4 \uAE08\uACE0\uC5D0\uC11C \uAE08\uC774 \uAC10\uCABD\uAC19\uC774
      \uC0AC\uB77C\uC84C\uC2B5\uB2C8\uB2E4. \uB4DC\uB798\uACE4\uC870\uCC28 \uB208\uCE58
      \uBABB \uCC58\uB2E4\uB2C8... \uB300\uB959\uC774 \uBC1C\uCE75 \uB4A4\uC9D1\uD614\uC2B5\uB2C8\uB2E4."
    changeMin: -20
    changeMax: -12
    isUncertain: 0
  - targetStock: {fileID: 11400000, guid: a71bfdbf57481854ca5adeac2b28cdf9, type: 2}
    eventText: "\uB4DC\uB798\uACE4 \uAE08\uACE0\uC5D0\uC11C \uD55C \uADC0\uC871 \uAC00\uBB38\uC774
      \uC7AC\uC0B0\uC744 \uD1B5\uC9F8\uB85C \uBE7C\uAC00\uACE0 \uC788\uC2B5\uB2C8\uB2E4.
      \uBB54\uAC00 \uD070\uC77C\uC774 \uBC8C\uC5B4\uC9C0\uB824\uB098 \uBD05\uB2C8\uB2E4."
    changeMin: -10
    changeMax: -5
    isUncertain: 0
  - targetStock: {fileID: 11400000, guid: 60bf84910a34b7d40974b19facac886e, type: 2}
    eventText: "\uC544\uC6B0\uB810\uB9AC\uC628\uC774 \uC5C4\uCCAD\uB09C \uB3C8\uC744
      \uAC78\uC5C8\uB358 \uD22C\uC790\uAC00 \uBB3C\uAC70\uD488\uC774 \uB418\uC5C8\uC2B5\uB2C8\uB2E4.
      \uC190\uC2E4\uC774 \uC5B4\uB9C8\uC5B4\uB9C8\uD558\uB2E4\uB294 \uC18C\uBB38\uC785\uB2C8\uB2E4."
    changeMin: -20
    changeMax: -12
    isUncertain: 0
  - targetStock: {fileID: 11400000, guid: 87a2212373dcefb499008b5c07c1266d, type: 2}
    eventText: "\uC5D0\uC774\uB354\uB2C8\uC5BC\uC774 \uD310\uB2E8\uC744 \uD06C\uAC8C
      \uC798\uBABB\uD574\uC11C \uACE0\uAC1D \uC790\uC0B0\uC774 \uB9CE\uC774 \uC904\uC5C8\uC2B5\uB2C8\uB2E4.
      \uB4DC\uB798\uACE4 \uAE08\uACE0\uAE4C\uC9C0 \uAC71\uC815\uB41C\uB2E4\uB294
      \uB9D0\uC774..."
    changeMin: -15
    changeMax: -8
    isUncertain: 1
  - targetStock: {fileID: 11400000, guid: a71bfdbf57481854ca5adeac2b28cdf9, type: 2}
    eventText: "\uB4DC\uB798\uACE4 \uAE08\uACE0\uC5D0 \uACE0\uB300 \uB9C8\uBC95 \uBD09\uC778\uC774
      \uC0C8\uB85C \uAC78\uB838\uC2B5\uB2C8\uB2E4. \"\uC774 \uAE08\uACE0\uB97C \uD138
      \uC218 \uC788\uB294 \uC790\uB294 \uB300\uB959\uC5D0 \uC5C6\uB2E4\"\uACE0 \uC790\uC2E0\uD558\uACE0
      \uC788\uC2B5\uB2C8\uB2E4."
    changeMin: 8
    changeMax: 15
    isUncertain: 1
  - targetStock: {fileID: 11400000, guid: a71bfdbf57481854ca5adeac2b28cdf9, type: 2}
    eventText: "\uB4DC\uB798\uACE4 \uAE08\uACE0\uC758 \uD574\uC678 \uC9C0\uC810\uC5D0\uC11C
      \uBCF4\uC548 \uC0AC\uACE0\uAC00 \uBC1C\uC0DD\uD588\uC2B5\uB2C8\uB2E4. \uC2E0\uB8B0\uB3C4\uC5D0
      \uD0C0\uACA9\uC785\uB2C8\uB2E4."
    changeMin: -10
    changeMax: -5
    isUncertain: 0
  - targetStock: {fileID: 11400000, guid: a71bfdbf57481854ca5adeac2b28cdf9, type: 2}
    eventText: "\uB4DC\uB798\uACE4 \uAE08\uACE0\uC758 \uBD84\uAE30 \uC218\uC775\uC774
      \uD06C\uAC8C \uC99D\uAC00\uD588\uC2B5\uB2C8\uB2E4. \uC790\uC0B0 \uAD00\uB9AC
      \uC218\uC218\uB8CC \uC218\uC785\uC774 \uD638\uC870\uC785\uB2C8\uB2E4."
    changeMin: 5
    changeMax: 10
    isUncertain: 0
  - targetStock: {fileID: 11400000, guid: a71bfdbf57481854ca5adeac2b28cdf9, type: 2}
    eventText: "\uB4DC\uB798\uACE4 \uAE08\uACE0\uC5D0 \uB9C8\uB178\uC0AC \uC655\uAD6D
      \uCD5C\uB300 \uADC0\uC871 \uAC00\uBB38\uC774 \uC804\uCCB4 \uC790\uC0B0\uC744
      \uC704\uD0C1\uD588\uC2B5\uB2C8\uB2E4."
    changeMin: 5
    changeMax: 10
    isUncertain: 0
  - targetStock: {fileID: 11400000, guid: a71bfdbf57481854ca5adeac2b28cdf9, type: 2}
    eventText: "\uB4DC\uB798\uACE4 \uAE08\uACE0\uAC00 \uC18C\uADDC\uBAA8 \uAD6D\uAC00\uC5D0
