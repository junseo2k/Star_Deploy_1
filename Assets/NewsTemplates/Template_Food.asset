    changeMin: -15
    changeMax: -8
  - targetStock: {fileID: 11400000, guid: 9c8de02b605ea094f9a080f6ddb438fd, type: 2}
    eventText: "\uC2E4\uBC14\uB098 \uADFC\uCC98\uC5D0 \uD574\uCDA9\uC774 \uB5BC\uB85C
