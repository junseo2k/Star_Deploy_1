    changeMax: -12
  - targetStock: {fileID: 11400000, guid: 4e4d5629aacf94b4ebc92546925858be, type: 2}
    eventText: "\uB9C8\uB178\uC0AC \uADF8\uB808\uC778\uC758 \uC2E0\uADDC \uB18D\uC7A5
