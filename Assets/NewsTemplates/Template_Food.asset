    changeMin: -10
    changeMax: -5
  - targetStock: {fileID: 11400000, guid: b74bb3fc2e862e948ada231910692bfb, type: 2}
    eventText: "\uC624\uB974\uCE74\uADF8\uB9AC \uBAA9\uC7A5\uC5D0 \uAC00\uCD95 \uC5ED\uBCD1\uC774
      \uD37C\uC84C\uC2B5\uB2C8\uB2E4. \uC218\uCC9C \uB9C8\uB9AC\uB97C \uCC98\uBD84\uD574\uC57C
      \uD569\uB2C8\uB2E4. \uCC38\uB2F4\uD55C \uC18C\uC2DD\uC785\uB2C8\uB2E4."
