  - targetStock: {fileID: 11400000, guid: 0a8f787cd0ab73c498a96b7f262ac48a, type: 2}
    eventText: "\uB8E8\uD2B8\uD790\uC5D0 \uC815\uCCB4 \uBAA8\uB97C \uB9C8\uB984\uBCD1\uC774
