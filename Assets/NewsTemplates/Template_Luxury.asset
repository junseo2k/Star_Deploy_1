  - targetStock: {fileID: 11400000, guid: 210ccee330775a94292f8fe35d5fd262, type: 2}
    eventText: "\uAE00\uB9BC\uC719\uC774 \uB0A9\uD488\uD55C \uBCF4\uC11D\uC774 \uAC00\uC9DC\uB77C\uB294
