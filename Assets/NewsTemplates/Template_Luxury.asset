  - targetStock: {fileID: 11400000, guid: 5760a42313da4ad4089598749d83883b, type: 2}
    eventText: "\uD06C\uB808\uC13C\uD2B8\uC5D0\uC11C \uD310 \uACE0\uAE09 \uC74C\uC2DD\uC5D0\uC11C
